; Engine configuration file.

config_version=5

[application]

config/name="Godot Game"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6")

[display]

; Sensible defaults: 1280×720 landscape fills the browser naturally.
; The agent CAN and SHOULD change viewport_width / viewport_height in
; project.godot to match the game (e.g. 480×854 portrait for an endless
; runner, 1920×1080 for a cinematic platformer). The stretch settings
; below adapt to any aspect ratio.
window/size/viewport_width=1280
window/size/viewport_height=720
; canvas_items scales 2D to the browser; expand fills the window and adapts
; to any aspect ratio without black bars. Build UI with Control anchors so it
; centers on every screen — never hardcode pixel positions.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"

[gui]

theme/custom_font="res://emoji_fallback/emoji_fallback_font.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"
theme/custom="res://fallback_fonts/_agon_default_theme.tres"























[autoload]

GameInput="*res://scaffold/game_input.gd"
GameAudio="*res://scaffold/game_audio.gd"
AgonDebug="*res://scaffold/agon_debug.gd"
